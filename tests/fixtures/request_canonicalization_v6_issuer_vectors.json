    {
      "id": "anthropic_messages_tool_schema_properties",
      "description": "Anthropic messages with a tool input_schema whose properties are named timestamp and authorization. v6 keeps the schema verbatim; v5 drops those property definitions. Top-level authorization is stripped by both.",
      "body": {
        "model": "claude-sonnet-5-5",
        "max_tokens": 512,
        "authorization": "Bearer placeholder",
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Schedule the call."
              }
            ]
          }
        ],
        "tools": [
          {
            "name": "schedule_call",
            "description": "Schedule a call",
            "input_schema": {
              "type": "object",
              "required": [
                "timestamp"
              ],
              "properties": {
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                },
                "authorization": {
                  "type": "string"
                },
                "attendee": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "metadata": {
          "user_id": "u_123",
          "request_id": "client-meta-9"
        }
      },
      "v1_sha256": "d3ecd6d27c08f6158c8d5dfd9c15f339fa193eb4f9c8de0f6f5a670bdae96206",
      "v5_sha256": "d3ecd6d27c08f6158c8d5dfd9c15f339fa193eb4f9c8de0f6f5a670bdae96206",
      "v6_sha256": "b1f8396cf8f886a5403c0f82eeef0270b09adcce5b7beb0e1874c4f52d0210a9",
      "v1_mcp_sha256": "d3ecd6d27c08f6158c8d5dfd9c15f339fa193eb4f9c8de0f6f5a670bdae96206",
      "v5_mcp_sha256": "d3ecd6d27c08f6158c8d5dfd9c15f339fa193eb4f9c8de0f6f5a670bdae96206",
      "v6_canonical_utf8": "{\"max_tokens\":512,\"messages\":[{\"content\":[{\"text\":\"Schedule the call.\",\"type\":\"text\"}],\"role\":\"user\"}],\"metadata\":{\"request_id\":\"client-meta-9\",\"user_id\":\"u_123\"},\"model\":\"claude-sonnet-5-5\",\"tools\":[{\"description\":\"Schedule a call\",\"input_schema\":{\"properties\":{\"attendee\":{\"type\":\"string\"},\"authorization\":{\"type\":\"string\"},\"timestamp\":{\"format\":\"date-time\",\"type\":\"string\"}},\"required\":[\"timestamp\"],\"type\":\"object\"},\"name\":\"schedule_call\"}]}"
