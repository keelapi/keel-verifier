{
  "schema_version": "keel.request_canonicalization_vectors.v1",
  "description": "Provider wire-body request canonicalization vectors produced by executing the Keel Issuer's canonical_provider_wire_body (keel-api app/services/permit_binding.py, commit 0b22118ca) on synthetic, Issuer-shaped request bodies. Values are placeholders, not credentials. v1_sha256 and v5_sha256 are computed as for a non-MCP dispatch; v1_mcp_sha256 and v5_mcp_sha256 as for an mcp dispatch, where the Issuer keeps params.arguments.idempotency_key of a tools/call body. v6 is the same for both.",
  "issuer_commit": "0b22118ca",
  "vectors": [
    {
      "id": "mcp_tools_call_nested_volatile_arguments",
      "description": "MCP tools/call: volatile and credential key names inside params.arguments are business arguments. v6 binds them; v5 drops them. Top-level request_id and x-keel-timestamp are stripped by both.",
      "body": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "tools/call",
        "request_id": "keel_req_01",
        "x-keel-timestamp": "2026-11-19T10:00:00Z",
        "params": {
          "name": "github.create_issue",
          "arguments": {
            "repository": "acme/app",
            "title": "Rotate staging key",
            "timestamp": "2026-11-19T09:59:00Z",
            "request_id": "customer-ticket-4411",
            "api_key": "placeholder-not-a-secret",
            "labels": [
              {
                "name": "security",
                "trace_id": "label-trace-1"
              }
            ]
          }
        }
      },
      "v1_sha256": "f480010c0baae23a236089cc38962348107307fc8ac6b8e639769b267d43579a",
      "v5_sha256": "f480010c0baae23a236089cc38962348107307fc8ac6b8e639769b267d43579a",
