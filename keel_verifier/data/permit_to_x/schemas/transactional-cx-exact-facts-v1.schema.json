{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/keelapi/keel-permit/schemas/transactional-cx-exact-facts-v1.schema.json",
  "title": "Keel exact transactional CX authorization facts v1",
  "oneOf": [
    {"$ref": "#/$defs/paymentRefund"},
    {"$ref": "#/$defs/accountCredit"},
    {"$ref": "#/$defs/subscriptionCancellationSchedule"},
    {"$ref": "#/$defs/subscriptionCancellationWithdraw"},
    {"$ref": "#/$defs/supportCaseResolve"}
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rawDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "amountMinor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999999999999
    },
    "signedAmountMinor": {
      "type": "integer",
      "minimum": -999999999999999,
      "maximum": 999999999999999
    },
    "negativeAmountMinor": {
      "type": "integer",
      "minimum": -999999999999999,
      "maximum": -1
    },
    "saltedCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "digest"],
      "properties": {
        "method": {"const": "keel.salted_sha256_jcs.v1"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "stripeCommon": {
      "type": "object",
      "required": [
        "version",
        "fact_profile_id",
        "action",
        "operation",
        "connector_identity",
        "connector_contract_hash",
        "tool_schema_hash",
        "decision_trace_hash",
        "tool_arguments_hash",
        "request_digest",
        "enforcement_mode",
        "provider_environment",
        "provider_api_version",
        "preflight_observed_at",
        "preflight_expires_at",
        "preflight_snapshot_digest",
        "idempotency_digest",
        "max_uses"
      ],
      "properties": {
        "version": {"const": "keel.transactional_cx_exact_facts.v1"},
        "operation": {"const": "call.tools"},
        "connector_identity": {"const": "stripe"},
        "connector_contract_hash": {"$ref": "#/$defs/rawDigest"},
        "tool_schema_hash": {"$ref": "#/$defs/rawDigest"},
        "decision_trace_hash": {"$ref": "#/$defs/rawDigest"},
        "tool_arguments_hash": {"$ref": "#/$defs/rawDigest"},
        "request_digest": {"$ref": "#/$defs/digest"},
        "enforcement_mode": {"const": "enforced_in_path"},
        "provider_environment": {"enum": ["test", "live"]},
        "provider_api_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "preflight_observed_at": {"$ref": "#/$defs/timestamp"},
        "preflight_expires_at": {"$ref": "#/$defs/timestamp"},
        "preflight_snapshot_digest": {"$ref": "#/$defs/digest"},
        "idempotency_digest": {"$ref": "#/$defs/digest"},
        "max_uses": {"const": 1}
      }
    },
    "hubspotCommon": {
      "type": "object",
      "required": [
        "version",
        "fact_profile_id",
        "action",
        "operation",
        "connector_identity",
        "connector_contract_hash",
        "tool_schema_hash",
        "decision_trace_hash",
        "tool_arguments_hash",
        "request_digest",
        "enforcement_mode",
        "provider_environment",
        "provider_api_version",
        "preflight_observed_at",
        "preflight_expires_at",
        "preflight_snapshot_digest",
        "idempotency_digest",
        "max_uses"
      ],
      "properties": {
        "version": {"const": "keel.transactional_cx_exact_facts.v1"},
        "operation": {"const": "call.tools"},
        "connector_identity": {"const": "hubspot"},
        "connector_contract_hash": {"$ref": "#/$defs/rawDigest"},
        "tool_schema_hash": {"$ref": "#/$defs/rawDigest"},
        "decision_trace_hash": {"$ref": "#/$defs/rawDigest"},
        "tool_arguments_hash": {"$ref": "#/$defs/rawDigest"},
        "request_digest": {"$ref": "#/$defs/digest"},
        "enforcement_mode": {"const": "enforced_in_path"},
        "provider_environment": {"enum": ["developer_test", "production"]},
        "provider_api_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "preflight_observed_at": {"$ref": "#/$defs/timestamp"},
        "preflight_expires_at": {"$ref": "#/$defs/timestamp"},
        "preflight_snapshot_digest": {"$ref": "#/$defs/digest"},
        "idempotency_digest": {"$ref": "#/$defs/digest"},
        "max_uses": {"const": 1}
      }
    },
    "paymentRefund": {
      "allOf": [
        {"$ref": "#/$defs/stripeCommon"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "fact_profile_id",
            "action",
            "operation",
            "connector_identity",
            "connector_contract_hash",
            "tool_schema_hash",
            "decision_trace_hash",
            "tool_arguments_hash",
            "request_digest",
            "enforcement_mode",
            "provider_environment",
            "provider_api_version",
            "preflight_observed_at",
            "preflight_expires_at",
            "preflight_snapshot_digest",
            "payment_reference_kind",
            "original_payment_reference_commitment",
            "payer_reference_commitment",
            "amount_minor",
            "refundable_amount_minor_before",
            "currency",
            "refund_reason",
            "refund_application_fee",
            "reverse_transfer",
            "payment_state_digest",
            "idempotency_digest",
            "max_uses"
          ],
          "properties": {
            "version": {"const": "keel.transactional_cx_exact_facts.v1"},
            "fact_profile_id": {"const": "keel.facts.refund_exact.v2"},
            "action": {"const": "payment.refund"},
            "operation": {"const": "call.tools"},
            "connector_identity": {"const": "stripe"},
            "connector_contract_hash": {"$ref": "#/$defs/rawDigest"},
            "tool_schema_hash": {"$ref": "#/$defs/rawDigest"},
            "decision_trace_hash": {"$ref": "#/$defs/rawDigest"},
            "tool_arguments_hash": {"$ref": "#/$defs/rawDigest"},
            "request_digest": {"$ref": "#/$defs/digest"},
            "enforcement_mode": {"const": "enforced_in_path"},
            "provider_environment": {"enum": ["test", "live"]},
            "provider_api_version": {"type": "string", "minLength": 1, "maxLength": 128},
            "preflight_observed_at": {"$ref": "#/$defs/timestamp"},
            "preflight_expires_at": {"$ref": "#/$defs/timestamp"},
            "preflight_snapshot_digest": {"$ref": "#/$defs/digest"},
            "payment_reference_kind": {"enum": ["charge", "payment_intent"]},
            "original_payment_reference_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "payer_reference_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "amount_minor": {"$ref": "#/$defs/amountMinor"},
            "refundable_amount_minor_before": {"$ref": "#/$defs/amountMinor"},
            "currency": {"$ref": "#/$defs/currency"},
            "refund_reason": {"enum": ["duplicate", "fraudulent", "requested_by_customer"]},
            "refund_application_fee": {"const": false},
            "reverse_transfer": {"const": false},
            "payment_state_digest": {"$ref": "#/$defs/digest"},
            "idempotency_digest": {"$ref": "#/$defs/digest"},
            "max_uses": {"const": 1}
          }
        }
      ]
    },
    "accountCredit": {
      "allOf": [
        {"$ref": "#/$defs/stripeCommon"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "fact_profile_id",
            "action",
            "operation",
            "connector_identity",
            "connector_contract_hash",
            "tool_schema_hash",
            "decision_trace_hash",
            "tool_arguments_hash",
            "request_digest",
            "enforcement_mode",
            "provider_environment",
            "provider_api_version",
            "preflight_observed_at",
            "preflight_expires_at",
            "preflight_snapshot_digest",
            "customer_reference_commitment",
            "amount_minor",
            "provider_amount_minor",
            "currency",
            "customer_balance_before_minor",
            "expected_customer_balance_after_minor",
            "credit_direction",
            "description_commitment",
            "customer_balance_state_digest",
            "idempotency_digest",
            "max_uses"
          ],
          "properties": {
            "version": {"const": "keel.transactional_cx_exact_facts.v1"},
            "fact_profile_id": {"const": "keel.facts.customer_credit_issue_exact.v1"},
            "action": {"const": "customer.credit.issue"},
            "operation": {"const": "call.tools"},
            "connector_identity": {"const": "stripe"},
            "connector_contract_hash": {"$ref": "#/$defs/rawDigest"},
            "tool_schema_hash": {"$ref": "#/$defs/rawDigest"},
            "decision_trace_hash": {"$ref": "#/$defs/rawDigest"},
            "tool_arguments_hash": {"$ref": "#/$defs/rawDigest"},
            "request_digest": {"$ref": "#/$defs/digest"},
            "enforcement_mode": {"const": "enforced_in_path"},
            "provider_environment": {"enum": ["test", "live"]},
            "provider_api_version": {"type": "string", "minLength": 1, "maxLength": 128},
            "preflight_observed_at": {"$ref": "#/$defs/timestamp"},
            "preflight_expires_at": {"$ref": "#/$defs/timestamp"},
            "preflight_snapshot_digest": {"$ref": "#/$defs/digest"},
            "customer_reference_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "amount_minor": {"$ref": "#/$defs/amountMinor"},
            "provider_amount_minor": {"$ref": "#/$defs/negativeAmountMinor"},
            "currency": {"$ref": "#/$defs/currency"},
            "customer_balance_before_minor": {"$ref": "#/$defs/signedAmountMinor"},
            "expected_customer_balance_after_minor": {"$ref": "#/$defs/signedAmountMinor"},
            "credit_direction": {"const": "customer_credit"},
            "description_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "customer_balance_state_digest": {"$ref": "#/$defs/digest"},
            "idempotency_digest": {"$ref": "#/$defs/digest"},
            "max_uses": {"const": 1}
          }
        }
      ]
    },
    "subscriptionCancellationSchedule": {
      "allOf": [
        {"$ref": "#/$defs/stripeCommon"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "fact_profile_id",
            "action",
            "operation",
            "connector_identity",
            "connector_contract_hash",
            "tool_schema_hash",
            "decision_trace_hash",
            "tool_arguments_hash",
            "request_digest",
            "enforcement_mode",
            "provider_environment",
            "provider_api_version",
            "preflight_observed_at",
            "preflight_expires_at",
            "preflight_snapshot_digest",
            "subscription_reference_commitment",
            "customer_reference_commitment",
            "subscription_status_before",
            "cancel_at_period_end_before",
            "cancel_at_period_end_requested",
            "current_period_end",
            "subscription_state_digest",
            "idempotency_digest",
            "max_uses"
          ],
          "properties": {
            "version": {"const": "keel.transactional_cx_exact_facts.v1"},
            "fact_profile_id": {"const": "keel.facts.subscription_cancellation_schedule_exact.v1"},
            "action": {"const": "subscription.cancellation.schedule"},
            "operation": {"const": "call.tools"},
            "connector_identity": {"const": "stripe"},
            "connector_contract_hash": {"$ref": "#/$defs/rawDigest"},
            "tool_schema_hash": {"$ref": "#/$defs/rawDigest"},
            "decision_trace_hash": {"$ref": "#/$defs/rawDigest"},
            "tool_arguments_hash": {"$ref": "#/$defs/rawDigest"},
            "request_digest": {"$ref": "#/$defs/digest"},
            "enforcement_mode": {"const": "enforced_in_path"},
            "provider_environment": {"enum": ["test", "live"]},
            "provider_api_version": {"type": "string", "minLength": 1, "maxLength": 128},
            "preflight_observed_at": {"$ref": "#/$defs/timestamp"},
            "preflight_expires_at": {"$ref": "#/$defs/timestamp"},
            "preflight_snapshot_digest": {"$ref": "#/$defs/digest"},
            "subscription_reference_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "customer_reference_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "subscription_status_before": {"enum": ["active", "trialing", "past_due"]},
            "cancel_at_period_end_before": {"const": false},
            "cancel_at_period_end_requested": {"const": true},
            "current_period_end": {"$ref": "#/$defs/timestamp"},
            "subscription_state_digest": {"$ref": "#/$defs/digest"},
            "idempotency_digest": {"$ref": "#/$defs/digest"},
            "max_uses": {"const": 1}
          }
        }
      ]
    },
    "subscriptionCancellationWithdraw": {
      "allOf": [
        {"$ref": "#/$defs/stripeCommon"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "fact_profile_id",
            "action",
            "operation",
            "connector_identity",
            "connector_contract_hash",
            "tool_schema_hash",
            "decision_trace_hash",
            "tool_arguments_hash",
            "request_digest",
            "enforcement_mode",
            "provider_environment",
            "provider_api_version",
            "preflight_observed_at",
            "preflight_expires_at",
            "preflight_snapshot_digest",
            "subscription_reference_commitment",
            "customer_reference_commitment",
            "subscription_status_before",
            "cancel_at_period_end_before",
            "cancel_at_period_end_requested",
            "current_period_end",
            "canceled_at_before",
            "ended_at_before",
            "subscription_state_digest",
            "idempotency_digest",
            "max_uses"
          ],
          "properties": {
            "version": {"const": "keel.transactional_cx_exact_facts.v1"},
            "fact_profile_id": {"const": "keel.facts.subscription_cancellation_withdraw_exact.v1"},
            "action": {"const": "subscription.cancellation.withdraw"},
            "operation": {"const": "call.tools"},
            "connector_identity": {"const": "stripe"},
            "connector_contract_hash": {"$ref": "#/$defs/rawDigest"},
            "tool_schema_hash": {"$ref": "#/$defs/rawDigest"},
            "decision_trace_hash": {"$ref": "#/$defs/rawDigest"},
            "tool_arguments_hash": {"$ref": "#/$defs/rawDigest"},
            "request_digest": {"$ref": "#/$defs/digest"},
            "enforcement_mode": {"const": "enforced_in_path"},
            "provider_environment": {"enum": ["test", "live"]},
            "provider_api_version": {"type": "string", "minLength": 1, "maxLength": 128},
            "preflight_observed_at": {"$ref": "#/$defs/timestamp"},
            "preflight_expires_at": {"$ref": "#/$defs/timestamp"},
            "preflight_snapshot_digest": {"$ref": "#/$defs/digest"},
            "subscription_reference_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "customer_reference_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "subscription_status_before": {"enum": ["active", "trialing", "past_due"]},
            "cancel_at_period_end_before": {"const": true},
            "cancel_at_period_end_requested": {"const": false},
            "current_period_end": {"$ref": "#/$defs/timestamp"},
            "canceled_at_before": {"type": "null"},
            "ended_at_before": {"type": "null"},
            "subscription_state_digest": {"$ref": "#/$defs/digest"},
            "idempotency_digest": {"$ref": "#/$defs/digest"},
            "max_uses": {"const": 1}
          }
        }
      ]
    },
    "supportCaseResolve": {
      "allOf": [
        {"$ref": "#/$defs/hubspotCommon"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "fact_profile_id",
            "action",
            "operation",
            "connector_identity",
            "connector_contract_hash",
            "tool_schema_hash",
            "decision_trace_hash",
            "tool_arguments_hash",
            "request_digest",
            "enforcement_mode",
            "provider_environment",
            "provider_api_version",
            "preflight_observed_at",
            "preflight_expires_at",
            "preflight_snapshot_digest",
            "ticket_reference_commitment",
            "pipeline_reference_commitment",
            "current_stage_reference_commitment",
            "requested_stage_reference_commitment",
            "current_stage_state",
            "requested_stage_state",
            "ticket_updated_at_before",
            "ticket_state_digest",
            "pipeline_state_digest",
            "resolution_summary_commitment",
            "idempotency_digest",
            "max_uses"
          ],
          "properties": {
            "version": {"const": "keel.transactional_cx_exact_facts.v1"},
            "fact_profile_id": {"const": "keel.facts.support_case_resolve_exact.v1"},
            "action": {"const": "support.case.resolve"},
            "operation": {"const": "call.tools"},
            "connector_identity": {"const": "hubspot"},
            "connector_contract_hash": {"$ref": "#/$defs/rawDigest"},
