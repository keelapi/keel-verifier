            "decision_trace_hash": {"$ref": "#/$defs/rawDigest"},
            "tool_arguments_hash": {"$ref": "#/$defs/rawDigest"},
            "request_digest": {"$ref": "#/$defs/digest"},
            "enforcement_mode": {"const": "enforced_in_path"},
            "provider_environment": {"enum": ["developer_test", "production"]},
            "provider_api_version": {"type": "string", "minLength": 1, "maxLength": 128},
            "preflight_observed_at": {"$ref": "#/$defs/timestamp"},
            "preflight_expires_at": {"$ref": "#/$defs/timestamp"},
            "preflight_snapshot_digest": {"$ref": "#/$defs/digest"},
            "ticket_reference_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "pipeline_reference_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "current_stage_reference_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "requested_stage_reference_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "current_stage_state": {"const": "OPEN"},
            "requested_stage_state": {"const": "CLOSED"},
            "ticket_updated_at_before": {"$ref": "#/$defs/timestamp"},
            "ticket_state_digest": {"$ref": "#/$defs/digest"},
            "pipeline_state_digest": {"$ref": "#/$defs/digest"},
            "resolution_summary_commitment": {"$ref": "#/$defs/saltedCommitment"},
            "idempotency_digest": {"$ref": "#/$defs/digest"},
            "max_uses": {"const": 1}
          }
        }
      ]
    }
  }
}
