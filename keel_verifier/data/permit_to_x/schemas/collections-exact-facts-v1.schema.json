        },
        "preflight_snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "idempotency_digest": {
          "$ref": "#/$defs/digest"
        },
        "max_uses": {
          "const": 1
        },
        "obligation_reference_commitment": {
          "$ref": "#/$defs/saltedCommitment"
        },
        "customer_reference_commitment": {
          "$ref": "#/$defs/saltedCommitment"
        },
        "price_reference_commitment": {
          "$ref": "#/$defs/saltedCommitment"
        },
        "installment_amount_minor": {
          "type": "integer",
          "minimum": 1
        },
        "installment_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 24
        },
        "total_plan_amount_minor": {
          "type": "integer",
          "minimum": 2
        },
        "remaining_balance_minor": {
          "type": "integer",
          "minimum": 2
        },
        "amount_matches_balance": {
          "const": true
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "billing_interval": {
          "enum": [
            "week",
            "month"
          ]
        },
        "plan_start_at": {
          "$ref": "#/$defs/timestamp"
        },
        "default_payment_method_present": {
          "const": true
        },
        "existing_active_plan_count": {
          "const": 0
        },
        "schedule_mode": {
          "const": "finite_subscription_schedule"
        },
        "collection_method": {
          "const": "charge_automatically"
        },
        "customer_consent_record_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "collections_autopay_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "fact_profile_id",
        "action",
        "operation",
        "connector_identity",
        "connector_contract_hash",
        "tool_schema_hash",
        "decision_trace_hash",
        "tool_arguments_hash",
        "request_digest",
        "enforcement_mode",
        "provider_environment",
        "provider_api_version",
        "preflight_observed_at",
        "preflight_expires_at",
        "preflight_snapshot_digest",
        "idempotency_digest",
        "max_uses",
        "plan_reference_commitment",
        "customer_reference_commitment",
        "subscription_status",
        "current_collection_method",
        "requested_collection_method",
        "autopay_enabled_before",
