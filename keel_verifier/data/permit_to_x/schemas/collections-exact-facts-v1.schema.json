        },
        "preflight_snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "idempotency_digest": {
          "$ref": "#/$defs/digest"
        },
        "max_uses": {
          "const": 1
        },
        "plan_reference_commitment": {
