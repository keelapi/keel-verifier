{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/keelapi/keel-permit/schemas/release-exact-facts-v1.schema.json",
  "title": "Keel exact Merge-to-Production authorization facts v1",
  "oneOf": [
    {
      "$ref": "#/$defs/repositoryPullRequestMerge"
    },
    {
      "$ref": "#/$defs/deploymentCommitDeploy"
    },
    {
      "$ref": "#/$defs/deploymentRollback"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rawDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "saltedCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "digest"
      ],
      "properties": {
        "method": {
          "const": "keel.salted_sha256_jcs.v1"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "repositoryPullRequestMerge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "fact_profile_id",
        "action",
        "operation",
        "connector_identity",
        "connector_contract_hash",
        "tool_schema_hash",
        "decision_trace_hash",
        "tool_arguments_hash",
        "request_digest",
        "enforcement_mode",
        "provider_environment",
        "provider_api_version",
        "preflight_observed_at",
        "preflight_expires_at",
        "preflight_snapshot_digest",
        "idempotency_digest",
        "max_uses",
        "repository_reference_commitment",
        "pull_request_number",
        "head_commit_sha",
        "base_branch",
        "base_branch_tip_sha",
        "pull_request_state",
        "draft",
        "mergeable",
        "mergeable_state",
        "merge_method",
        "branch_protection_source",
        "strict_status_checks",
        "required_status_checks_count",
        "required_status_checks_state",
        "required_approving_reviews",
        "observed_approving_reviews",
        "dismiss_stale_reviews",
        "require_last_push_approval",
        "required_conversation_resolution",
        "enforce_admins",
        "branch_protection_state_digest",
        "pull_request_state_digest",
        "checks_state_digest",
        "reviews_state_digest"
      ],
      "properties": {
        "version": {
          "const": "keel.release_exact_facts.v1"
        },
        "fact_profile_id": {
          "const": "keel.facts.repository_pull_request_merge_exact.v1"
        },
        "action": {
          "const": "repository.pull_request.merge"
        },
        "operation": {
          "const": "call.tools"
        },
        "connector_identity": {
          "const": "github"
        },
        "connector_contract_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tool_schema_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_trace_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tool_arguments_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "enforcement_mode": {
          "const": "enforced_in_path"
        },
        "provider_environment": {
          "const": "dedicated_demo"
        },
        "provider_api_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "preflight_observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
        },
        "preflight_expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
        },
        "preflight_snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "idempotency_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "max_uses": {
          "const": 1
        },
        "repository_reference_commitment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "digest"
          ],
          "properties": {
            "method": {
              "const": "keel.salted_sha256_jcs.v1"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "pull_request_number": {
          "type": "integer",
          "minimum": 1
        },
        "head_commit_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "base_branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$"
        },
        "base_branch_tip_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "pull_request_state": {
          "const": "open"
        },
        "draft": {
          "const": false
        },
        "mergeable": {
          "const": true
        },
        "mergeable_state": {
          "const": "clean"
        },
        "merge_method": {
          "enum": [
            "merge",
            "squash",
            "rebase"
          ]
        },
        "branch_protection_source": {
          "const": "branch_protection"
        },
        "strict_status_checks": {
          "const": true
        },
        "required_status_checks_count": {
          "type": "integer",
          "minimum": 1
        },
        "required_status_checks_state": {
          "const": "success"
        },
        "required_approving_reviews": {
          "type": "integer",
          "minimum": 1
        },
        "observed_approving_reviews": {
          "type": "integer",
          "minimum": 1
        },
        "dismiss_stale_reviews": {
          "const": true
        },
        "require_last_push_approval": {
          "const": true
        },
        "required_conversation_resolution": {
          "const": true
        },
        "enforce_admins": {
          "const": true
        },
        "branch_protection_state_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pull_request_state_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "checks_state_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reviews_state_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
