{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/keelapi/keel-permit/schemas/work-chain-pack-v2.schema.json",
  "title": "Keel heterogeneous work-chain evidence pack v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profile",
    "project_id",
    "root_permit_id",
    "export_source",
    "declared_cutoff",
    "scope_commitment",
    "scope_commitment_signature",
    "root",
    "authorities",
    "child_permits",
    "value_events",
    "lifecycle_events",
    "review_transitions",
    "provider_value_facts",
    "policy_snapshots",
    "evidence_artifacts",
    "artifacts",
    "requested_claims",
    "summary"
  ],
  "properties": {
    "version": {"const": "keel.work_chain_pack.v2"},
    "profile": {"const": "work-chain.v2"},
    "project_id": {"type": "string", "format": "uuid"},
    "root_permit_id": {"type": "string", "format": "uuid"},
    "export_source": {"$ref": "#/$defs/export_source"},
    "declared_cutoff": {"$ref": "#/$defs/declared_cutoff"},
    "scope_commitment": {"$ref": "#/$defs/scope_commitment"},
    "scope_commitment_signature": {"$ref": "#/$defs/scope_commitment_signature"},
    "root": {"$ref": "#/$defs/root_evidence"},
    "authorities": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "https://github.com/keelapi/keel-permit/schemas/work-authority-v2.schema.json"}
    },
    "child_permits": {
      "type": "array",
      "items": {"$ref": "#/$defs/child_permit_evidence"}
    },
    "value_events": {
      "type": "array",
      "items": {"$ref": "https://github.com/keelapi/keel-permit/schemas/work-value-event-v2.schema.json"}
    },
    "lifecycle_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/lifecycle_event"}
    },
    "review_transitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_reference"}
    },
    "provider_value_facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_reference"}
    },
    "policy_snapshots": {
      "type": "array",
      "items": {"$ref": "#/$defs/policy_snapshot"}
    },
    "evidence_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_reference"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "requested_claims": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "permit.work_authority_manifest.v2",
          "permit.work_child_containment.v2",
          "permit_chain.execution_authorized_at_boundary.v2",
          "permit.work_value_conservation.v2",
          "permit.work_exact_review.v1"
        ]
      },
      "allOf": [
        {"contains": {"const": "permit.work_authority_manifest.v2"}},
        {"contains": {"const": "permit.work_child_containment.v2"}},
        {"contains": {"const": "permit_chain.execution_authorized_at_boundary.v2"}},
        {"contains": {"const": "permit.work_value_conservation.v2"}},
        {"contains": {"const": "permit.work_exact_review.v1"}}
      ]
    },
    "summary": {"$ref": "https://github.com/keelapi/keel-permit/schemas/work-summary-v1.schema.json"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "export_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_id"],
      "properties": {
        "source_kind": {"const": "keel_recorded_governance"},
        "source_id": {"type": "string", "minLength": 1}
      }
    },
    "declared_cutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_through", "checkpoint_id", "checkpoint_digest"],
      "properties": {
        "recorded_through": {"type": "string", "format": "date-time"},
        "checkpoint_id": {"type": "string", "format": "uuid"},
        "checkpoint_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "scope_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "claim", "runtime_recording_claim", "populations"],
      "properties": {
        "version": {"const": "keel.work_scope_commitment.v2"},
        "claim": {
          "const": "scope-faithful slice of Keel-recorded work evidence through the declared cutoff"
        },
        "runtime_recording_claim": {"const": "not_asserted"},
        "populations": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/population_commitment"}
        }
      }
    },
    "population_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "source_relation", "included_count", "included_set_hash"],
      "properties": {
        "population": {
          "enum": [
            "work_authorities",
            "child_permits",
            "work_value_events",
            "lifecycle_events",
            "review_transitions",
            "provider_value_facts"
          ]
        },
        "source_relation": {"type": "string", "minLength": 1},
        "included_count": {"type": "integer", "minimum": 0},
        "included_set_hash": {"$ref": "#/$defs/digest"}
      }
    },
    "scope_commitment_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "signature_profile",
        "binding_key_id",
        "canonical_hash",
        "signature",
        "signed_at"
      ],
      "properties": {
        "version": {"const": "keel.work_scope_commitment_signature.v2"},
        "signature_profile": {"const": "keel.canonical_json.payload.v1"},
        "binding_key_id": {"type": "string", "minLength": 1},
        "canonical_hash": {"$ref": "#/$defs/digest"},
        "signature": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9+/]+={0,2}$"},
        "signed_at": {"type": "string", "format": "date-time"}
      }
    },
    "root_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permit_artifact", "work_request", "work_package", "semantic_binding"],
      "properties": {
        "permit_artifact": {"$ref": "#/$defs/artifact_reference"},
        "work_request": {"$ref": "https://github.com/keelapi/keel-permit/schemas/work-request-v2.schema.json"},
        "work_package": {"$ref": "https://github.com/keelapi/keel-permit/schemas/work-package-v2.schema.json"},
        "semantic_binding": {"$ref": "https://github.com/keelapi/keel-permit/schemas/permit-semantic-binding-v2.schema.json"}
      }
    },
    "child_permit_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permit_id",
        "work_authority_id",
        "decision",
        "request_digest",
        "work_binding",
        "authorization_fact_artifacts",
        "permit_artifact"
      ],
      "properties": {
        "permit_id": {"type": "string", "format": "uuid"},
        "work_authority_id": {"$ref": "#/$defs/authority_id"},
        "decision": {"enum": ["allow", "deny", "challenge"]},
        "request_digest": {"$ref": "#/$defs/digest"},
        "work_binding": {"$ref": "https://github.com/keelapi/keel-permit/schemas/work-binding-v2.schema.json"},
        "semantic_binding": {"$ref": "https://github.com/keelapi/keel-permit/schemas/permit-semantic-binding-v2.schema.json"},
        "authorization_fact_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact_reference"}
        },
        "review_transition": {"$ref": "#/$defs/artifact_reference"},
        "provider_value_fact": {"$ref": "#/$defs/artifact_reference"},
        "permit_artifact": {"$ref": "#/$defs/artifact_reference"},
        "dispatch_boundary_evidence": {"$ref": "#/$defs/artifact_reference"}
      }
    },
    "lifecycle_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "occurred_at", "event_digest"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "event_type": {
          "enum": [
            "work.issued",
            "work.closed",
            "permit.revoked",
            "work.authority.revoked",
            "work.delegation.revoked",
            "principal.revoked",
            "credential.revoked",
            "dispatch.egress_bound"
          ]
        },
        "permit_id": {"type": "string", "format": "uuid"},
        "authority_id": {"$ref": "#/$defs/authority_id"},
        "delegation_id": {"type": "string", "format": "uuid"},
        "principal_id": {"type": "string", "format": "uuid"},
        "authenticated_credential_id_digest": {"$ref": "#/$defs/digest"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "event_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "policy_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "policy_id", "policy_version", "policy_snapshot_hash"],
      "properties": {
        "phase": {"enum": ["root_issuance", "child_issuance", "review_resume", "dispatch"]},
        "permit_id": {"type": "string", "format": "uuid"},
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "policy_snapshot_hash": {"$ref": "#/$defs/digest"}
      }
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "artifact_digest"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_type": {"type": "string", "minLength": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "artifact_digest", "payload"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_type": {"type": "string", "minLength": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "payload": {"type": "object"}
      }
    }
  }
}
