{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/keelapi/keel-permit/schemas/work-dispatch-boundary-v2.schema.json",
  "title": "Keel Work pre-effect dispatch boundary v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "event_type",
    "project_id",
    "root_permit_id",
    "authority_id",
    "child_permit_id",
    "dispatch_attempt_id",
    "request_digest",
    "provider_wire_body_digest",
    "authenticated_credential_id_digest",
    "idempotency_key_digest",
    "pre_effect",
    "gate_result",
    "dispatch_ownership_committed",
    "upstream_called",
    "liveness",
    "execution_policy",
    "asserts_provider_acceptance",
    "asserts_business_job_completed",
    "asserts_settlement",
    "occurred_at",
    "binding_key_id",
    "canonical_hash",
    "signature"
  ],
  "properties": {
    "version": {"const": "keel.work_dispatch_boundary.v2"},
    "event_type": {"const": "dispatch.egress_bound"},
    "project_id": {"type": "string", "format": "uuid"},
    "root_permit_id": {"type": "string", "format": "uuid"},
    "authority_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "child_permit_id": {"type": "string", "format": "uuid"},
    "dispatch_attempt_id": {"type": "string", "format": "uuid"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "provider_wire_body_digest": {"$ref": "#/$defs/digest"},
    "authenticated_credential_id_digest": {"$ref": "#/$defs/digest"},
    "idempotency_key_digest": {"$ref": "#/$defs/digest"},
    "pre_effect": {"const": true},
    "gate_result": {"const": "allow"},
    "dispatch_ownership_committed": {"const": true},
    "upstream_called": {"const": false},
    "liveness": {"$ref": "#/$defs/liveness"},
    "execution_policy": {"$ref": "#/$defs/policy_snapshot"},
    "asserts_provider_acceptance": {"const": false},
    "asserts_business_job_completed": {"const": false},
    "asserts_settlement": {"const": false},
    "occurred_at": {"type": "string", "format": "date-time"},
    "binding_key_id": {"type": "string", "minLength": 1},
    "canonical_hash": {"$ref": "#/$defs/digest"},
    "signature": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9+/]+={0,2}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "liveness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_live",
        "authority_live",
        "child_live",
        "delegation_live",
        "principal_live",
        "credential_live",
        "approval_live",
        "reservation_live",
        "current_policy_epoch_matched",
        "platform_safety_floor_passed",
        "exact_request_matched",
        "provider_wire_body_matched"
      ],
      "properties": {
        "root_live": {"const": true},
        "authority_live": {"const": true},
        "child_live": {"const": true},
        "delegation_live": {"const": true},
        "principal_live": {"const": true},
        "credential_live": {"const": true},
        "approval_live": {"const": true},
        "reservation_live": {"const": true},
        "current_policy_epoch_matched": {"const": true},
        "platform_safety_floor_passed": {"const": true},
        "exact_request_matched": {"const": true},
        "provider_wire_body_matched": {"const": true}
      }
    },
    "policy_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_snapshot_hash"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "policy_snapshot_hash": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
