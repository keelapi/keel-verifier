{
  "version": "keel.permit.action_classification_derivation.test_vectors.v1",
  "ruleset": "../../semantics/permit/action_classification_derivation_v1.json",
  "classification_registry": "../../semantics/permit/value_movement_classification_v1.json",
  "classification_registry_digest": "sha256:c46b8bd165ef16c284621e5349b22e5621fe66c4a25a3c8b18c8d88e20de76d0",
  "canonicalization_profile": "keel.canonical_json.payload.v1",
  "given_model": "Each vector's `given` is the verifier's explicit immutable environment. trusted_registry_digests is the trust set (step 3 resolves only a digest in it). The verifier always has the pinned canonical registry's real bytes available for its own digest. `store` optionally supplies byte-concrete (digest, content_utf8) pairs so integrity vectors are realizable: content that does not hash to its claimed digest triggers step-3 dependency_integrity; hash-correct content that is not a valid registry triggers step-4 dependency_artifact_invalid.",
  "conformance": "Passing every vector is NECESSARY, NOT SUFFICIENT. The ruleset decision_algorithm, profile/grammar definitions, and verification_inputs are the complete contract; this corpus is mandatory minimum evidence. reference_executor.py runs the algorithm against every vector from the spec.",
  "step9_conflict_designed_out": "Round-3's step-9 counterexample is not constructible in v1: integrity/digest checks are global steps 3/4/6 before rule matching; the rule's only per-rule predicates (membership, enforcement) are both -> no_derivation.",
  "outcomes": [
    "valid",
    "no_derivation",
    "invalid",
    "unverifiable"
  ],
  "deferred_coverage": "multiple-applicable-rules / rule-order-permutation need a synthetic 2-rule fixture (with the second Permit-to-X rule). Full canonicalization/Unicode/JSON-boundary suites and resolver-multiplicity are property tests co-designed with the reference verifier.",
