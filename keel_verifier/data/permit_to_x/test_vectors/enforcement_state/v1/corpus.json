        "version": "keel.permit_enforcement_state.v1",
        "surface": "work",
        "effective_mode": "enforce",
        "global_ceiling": "enforce",
        "project_rung": "enforce",
        "mapping_version": "keel.enforcement_rung_mapping.v1",
