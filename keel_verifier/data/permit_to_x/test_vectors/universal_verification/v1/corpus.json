        "dispatch_at": "2026-07-30T13:00:00Z",
        "expires_at": "2026-07-30T13:00:00Z",
        "dispatch_instant_trusted": true
      },
      "expected": {"verdict": "disproved", "reason": "PERMIT_EXPIRED_AT_DISPATCH"}
    },
    {
      "id": "negative-revoked-at-dispatch",
      "claim": "permit.revocation_at_dispatch.v1",
