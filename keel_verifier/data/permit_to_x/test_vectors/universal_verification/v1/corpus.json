        "adapter_certification_digest_matches": false,
        "deployment_assurance": "supported_active",
        "runtime_enforcement_proof": "supported_pre_effect"
      },
      "expected": {"verdict": "disproved", "reason": "CERTIFICATION_BINDING_MISMATCH"}
    },
    {
