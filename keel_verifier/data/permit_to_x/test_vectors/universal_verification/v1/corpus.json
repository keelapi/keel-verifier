    },
    {
      "id": "negative-idempotency-rebound",
      "claim": "permit.idempotency_bound.v1",
      "given": {
        "idempotency_key_commitment": "sha256:8888888888888888888888888888888888888888888888888888888888888888",
        "bound_request_digests": [
          "sha256:6666666666666666666666666666666666666666666666666666666666666666",
          "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
        ]
      },
      "expected": {"verdict": "disproved", "reason": "PERMIT_IDEMPOTENCY_BINDING_MISMATCH"}
    },
    {
      "id": "positive-provider-rejected",
      "claim": "provider.rejected.v1",
      "given": {
        "receipt_state": "supported",
        "state": "rejected",
        "source_class": "provider_response",
        "receipt_chain_valid": true
      },
      "expected": {"verdict": "supported", "reason": "PROVIDER_REJECTION_VERIFIED"}
    },
    {
      "id": "negative-transport-observation-cannot-establish-acceptance",
      "claim": "provider.accepted.v1",
      "given": {
        "receipt_state": "supported",
        "state": "accepted",
        "source_class": "keel_transport_observation"
      },
      "expected": {"verdict": "disproved", "reason": "PROVIDER_RECEIPT_SOURCE_CEILING"}
    },
    {
      "id": "positive-provider-accepted-does-not-complete",
      "claim": "provider.accepted.v1",
      "given": {
        "receipt_state": "supported",
        "state": "accepted",
        "source_class": "provider_response"
      },
      "expected": {
        "verdict": "supported",
        "reason": "PROVIDER_ACCEPTANCE_VERIFIED",
        "does_not_establish": [
          "provider completion",
          "external real-world outcome"
        ]
      }
    },
    {
      "id": "positive-provider-completed-remains-provider-asserted",
      "claim": "provider.completed.v1",
      "given": {
        "receipt_state": "supported",
        "state": "completed",
        "source_class": "provider_webhook"
      },
      "expected": {
        "verdict": "supported",
        "reason": "PROVIDER_COMPLETION_REPORTED",
        "does_not_establish": [
          "independent truth of a provider assertion",
          "external real-world outcome without independently verified evidence"
        ]
      }
    },
    {
      "id": "negative-low-entropy-plain-hash",
      "claim": "permit.type.v1",
      "given": {
        "field_classification": "personal_data",
        "low_entropy_possible": true,
        "commitment_method": "plain_sha256"
      },
      "expected": {
        "verdict": "disproved",
        "reason": "DISCLOSURE_LOW_ENTROPY_PLAIN_HASH_FORBIDDEN"
      }
    },
    {
      "id": "negative-declared-claim-never-silently-omitted",
      "claim": "provider.completed.v1",
      "given": {
        "claim_declared": true,
        "provider_receipt_missing": true
      },
      "expected": {
        "claim_emitted": true,
        "verdict": "insufficient_evidence",
        "reason": "PROVIDER_STATE_EVIDENCE_MISSING"
      }
    }
  ]
