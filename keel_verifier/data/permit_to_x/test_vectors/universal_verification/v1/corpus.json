        "dispatch_at": "2026-07-30T12:10:00Z",
        "effective_revocation_at": "2026-07-30T12:09:59Z",
        "lifecycle_scope_faithful": true
      },
      "expected": {"verdict": "disproved", "reason": "PERMIT_REVOKED_AT_DISPATCH"}
    },
    {
      "id": "positive-certified-boundary",
      "claim": "permit.enforced_at_certified_boundary.v1",
