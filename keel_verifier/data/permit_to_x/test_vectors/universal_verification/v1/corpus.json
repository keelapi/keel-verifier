        "dispatch_at": "2026-07-30T12:10:00Z",
        "expires_at": "2026-07-30T13:00:00Z",
        "dispatch_instant_trusted": true
      },
      "expected": {"verdict": "supported", "reason": "PERMIT_VALID_AT_DISPATCH"}
    },
    {
      "id": "negative-expiry-boundary-is-exclusive",
