  "vectors": [
    {
      "id": "positive-specific-permit-type",
      "claim": "permit.type.v1",
      "given": {
        "decision": "supported",
        "semantic_matches": ["keel.action.payment_execute.v1"],
        "fact_profile": "keel.facts.payment_exact.v1",
        "contracts_pinned": true,
        "facts_schema_valid": true,
        "signed_resource_attributes_match": true
      },
      "expected": {"verdict": "supported", "reason": "PERMIT_TYPE_VERIFIED"}
    },
    {
      "id": "negative-ambiguous-permit-type",
      "claim": "permit.type.v1",
      "given": {
        "decision": "supported",
        "semantic_matches": [
          "keel.action.payment_execute.v1",
          "keel.action.generate_text.v1"
        ],
        "contracts_pinned": true
      },
      "expected": {"verdict": "insufficient_evidence", "reason": "PERMIT_TYPE_UNRESOLVED"}
    },
    {
      "id": "negative-exact-target-diverges",
      "claim": "permit.exact_target.v1",
      "given": {
        "type": "supported",
        "signed_target_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "projected_target_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "expected": {"verdict": "disproved", "reason": "PERMIT_EXACT_TARGET_MISMATCH"}
    },
    {
      "id": "negative-material-request-diverges",
