{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/keelapi/keel-permit/fact_profiles/v1.schema.json",
  "title": "Keel Permit fact profile registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "version", "canonicalization_profile", "profiles"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "artifact_id": {
      "type": "string",
      "const": "keel.permit.fact_profile_registry"
    },
    "version": {
      "type": "string",
      "const": "keel.fact_profile_registry.v1"
    },
    "canonicalization_profile": {
      "type": "string",
      "const": "rfc8785"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_profile_id",
        "semantic_ids",
        "facts_schema",
        "facts_schema_digest",
        "fields",
        "release_state"
      ],
      "properties": {
        "fact_profile_id": {
          "type": "string",
          "pattern": "^keel\\.facts\\.[a-z0-9._-]+\\.v[0-9]+$"
        },
        "semantic_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^keel\\.[a-z0-9._-]+\\.v[0-9]+$"
          }
        },
        "facts_schema": {
          "type": "string",
          "pattern": "^schemas/[a-z0-9._-]+\\.schema\\.json$"
        },
        "facts_schema_digest": {
          "$ref": "#/$defs/digest"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "release_state": {
          "type": "string",
          "enum": ["eligible", "reserved", "internal_only"]
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "value_type",
        "required_for_authorization",
        "classification",
        "bulk_export_disclosure",
        "exact_pack_disclosure",
        "retention_class",
        "erasable",
        "commitment_method"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[a-z0-9_/-]+$"
        },
        "value_type": {
          "type": "string",
          "enum": ["integer", "string", "digest", "commitment"]
        },
        "required_for_authorization": {
          "type": "boolean"
        },
        "classification": {
          "type": "string",
          "enum": [
            "operational",
            "financial",
            "personal_data",
            "secret",
            "free_text"
          ]
        },
        "bulk_export_disclosure": {
          "type": "string",
          "enum": ["omit", "commitment", "cleartext"]
        },
        "exact_pack_disclosure": {
          "type": "string",
          "enum": [
            "omit",
            "cleartext",
            "commitment",
            "commitment_with_optional_opening"
          ]
        },
        "retention_class": {
          "type": "string",
          "enum": ["permit_evidence", "deletable_identity", "transient"]
        },
        "erasable": {
          "type": "boolean"
        },
        "commitment_method": {
          "type": "string",
          "enum": [
            "signed_cleartext",
            "keel.salted_sha256_jcs.v1",
            "none"
          ]
        }
      }
    }
  }
}
