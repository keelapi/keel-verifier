  "human_artifact_contract": {
    "artifact_schema": "schemas/permit-human-artifact-v1.schema.json",
    "package_manifest_schema": "schemas/permit-package-manifest-v1.schema.json",
    "default_view": "human",
    "title_source": "verified_semantic_profile",
    "state_titles": {
      "denial": "AI Action Denied",
      "review": "AI Action Awaiting Approval"
    },
    "status_labels": {
      "authorized": "Authorized, not dispatched",
      "dispatched": "Dispatched, provider outcome pending",
      "provider_accepted": "Provider accepted",
      "provider_completed": "Provider reported completion",
      "provider_rejected": "Provider rejected",
      "outcome_unknown": "External outcome unknown",
      "expired_unused": "Expired unused",
      "revoked": "Revoked",
      "denied": "Denied before dispatch",
      "awaiting_approval": "No dispatch before approval"
    },
    "summary": {
      "position": "end",
      "derivation": "verifier_from_verified_fields",
      "template": "semantics/permit/human_summary_v1.json",
      "required_inputs": [
        "artifact_kind",
        "agent",
        "action",
        "target",
        "issued_at",
        "expires_at",
        "dispatch_state",
        "provider_state",
        "provider_object_id",
        "integrity_verdict",
        "trust_mode"
      ],
      "missing_value_rule": "omit_never_invent"
    },
    "lifecycle_fields": {
      "required": [
        "issued_at",
        "expires_at",
        "status"
      ],
      "optional": [
        "expiry_limiting_source",
        "dispatched_at",
        "first_used_at",
        "last_used_at",
        "use_count",
        "max_uses",
        "revoked_at",
        "verified_at"
      ]
    },
    "advanced_representations": [
      "signed_evidence_json",
      "canonical_signed_bytes",
      "canonical_signed_bytes_hex",
      "canonical_signed_bytes_base64",
      "signatures",
      "digests",
      "contract_pins"
    ],
    "package_trust_rule": "verify_signed_evidence_and_regenerate_human_view"
  },
